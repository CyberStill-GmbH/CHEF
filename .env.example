# Copiar a .env y completar. .env está ignorado y nunca debe commitearse.
# Sin CHEF_SESSION_SECRET (32+ caracteres) la API no arranca: no hay modo
# "sin autenticación".
CHEF_SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# IDs numéricos de los miembros habilitados, separados por coma; obligatorio en producción.
CHEF_ALLOWED_GITHUB_USER_IDS=
GITHUB_REDIRECT_URI=http://127.0.0.1:8787/auth/github/callback
PORT=8787
CHEF_SCOPE=fixtures/scope/lab.json

# Con DATABASE_URL la API usa Prisma/PostgreSQL. En Railway es obligatoria.
DATABASE_URL=postgresql://chef:chef-dev-only@127.0.0.1:5432/chef?schema=public

# Backup/restore: auto usa clientes nativos si existen; si no, Docker.
CHEF_DB_TOOLS_MODE=auto
CHEF_POSTGRES_IMAGE=postgres:16-alpine
# CHEF_DB_TOOLS_NETWORK=nombre-de-red-docker

# Copiar a .env y completar. .env está ignorado y nunca debe commitearse.
# Sin CHEF_SESSION_SECRET (32+ caracteres) la API no arranca: no hay modo
# "sin autenticación".
CHEF_SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8787/auth/github/callback
PORT=8787
CHEF_SCOPE=fixtures/scope/lab.json

# Solo lo usa el adaptador Prisma cuando se componga; la API actual persiste
# en memoria y no se conecta a la base.
DATABASE_URL=postgresql://chef:chef-dev-only@127.0.0.1:5432/chef?schema=public
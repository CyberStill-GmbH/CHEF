{
  "name": "chef-evidence-core",
  "version": "0.1.0",
  "private": true,
  "description": "Offline, evidence-backed attack surface correlation for authorized assessments",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check:docs": "node scripts/check-docs.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:docs && npm run check:architecture && npm run web:check && npm run format:check",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "web:test": "vitest run --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:check": "npm run web:typecheck && npm run web:test && npm run web:build",
    "demo": "npm run build && node dist/apps/cli/src/main.js fixtures/nmap/lab.xml fixtures/scope/lab.json",
    "benchmark": "npm run build && node dist/scripts/benchmark.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-xml-parser": "5.11.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "mermaid": "11.17.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}

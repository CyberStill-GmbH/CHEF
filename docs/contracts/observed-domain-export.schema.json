{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chef.invalid/contracts/observed-domain-export.schema.json",
  "title": "Exportación CHEF de dominios observados",
  "description": "Lista local determinista basada solo en eventos DNS_NAME directos; no afirma alcance, resolución actual ni propiedad.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "scopeStatus", "domains"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^run:[a-z0-9:-]+$"
    },
    "scopeStatus": { "const": "not_asserted" },
    "domains": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "name", "qualification", "evidence"],
        "properties": {
          "assetId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9._-]+$"
          },
          "qualification": { "const": "observed" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "sourceEventId", "eventType", "observedAt"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "sourceEventId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "eventType": { "const": "DNS_NAME" },
                "observedAt": {
                  "type": "string",
                  "format": "date-time",
                  "maxLength": 40
                }
              }
            }
          }
        }
      }
    }
  }
}

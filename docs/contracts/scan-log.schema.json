{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chef.invalid/contracts/scan-log.schema.json",
  "title": "Evento de actividad CHEF",
  "description": "Evento IPC interno para la importación de evidencia offline. No autoriza ni ejecuta reconocimiento de red.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "requestId",
    "sequence",
    "phase",
    "message"
  ],
  "properties": {
    "schemaVersion": { "const": "1.2.0" },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9:-]+$"
    },
    "requestId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sequence": { "type": "integer", "minimum": 1 },
    "phase": {
      "enum": [
        "started",
        "event",
        "validated",
        "stored",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Z0-9_]+$"
    },
    "observedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
  }
}

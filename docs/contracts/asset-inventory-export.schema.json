{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chef.invalid/contracts/asset-inventory-export.schema.json",
  "title": "Exportación CHEF de inventario de activos",
  "description": "Resumen CSV por host de relaciones CHEF observadas con evidencia. No afirma alcance ni califica vulnerabilidades.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "fileName",
    "contentType",
    "scopeStatus",
    "rowCount",
    "csv"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^run:[a-z0-9:-]+$"
    },
    "fileName": {
      "type": "string",
      "maxLength": 148,
      "pattern": "^chef-inventario-run-[a-z0-9-]+\\.csv$"
    },
    "contentType": { "const": "text/csv; charset=utf-8" },
    "scopeStatus": { "const": "not_asserted" },
    "rowCount": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "csv": { "type": "string", "minLength": 1, "maxLength": 2097152 }
  }
}

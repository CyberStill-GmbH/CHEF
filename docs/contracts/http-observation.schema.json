{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chef.local/http-observation/1.1.0",
  "title": "Proposed CHEF normalized HTTP selection envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observations"],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "observations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "fact",
          "method",
          "origin",
          "pathSha256",
          "observedAt",
          "assertion",
          "confidence",
          "evidence",
          "scopePolicyId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^observation:[a-f0-9]{64}$"
          },
          "source": {
            "const": "burp-selection"
          },
          "fact": {
            "const": "http-endpoint"
          },
          "method": {
            "type": "string",
            "pattern": "^[A-Z]{1,16}$"
          },
          "origin": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "pathSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "assertion": {
            "const": "observed"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["digestKind", "sha256", "locator"],
            "properties": {
              "digestKind": {
                "const": "normalized-metadata"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "locator": {
                "type": "string",
                "pattern": "^burp-selection:[0-9]+$"
              }
            }
          },
          "scopePolicyId": {
            "const": "burp-project-scope"
          }
        }
      }
    }
  }
}

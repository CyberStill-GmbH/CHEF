{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chef.local/schema/recon-graph-progress/1.0.0",
  "title": "Avance validado del grafo CHEF 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "jobId",
    "sequence",
    "phase",
    "assets",
    "evidence",
    "relationships",
    "unmappedEventTypes"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sequence": { "type": "integer", "minimum": 1 },
    "phase": { "enum": ["evidence", "assets", "relationships", "completed"] },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "https://chef.local/schema/recon-graph/1.4.0#/$defs/Asset"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "https://chef.local/schema/recon-graph/1.4.0#/$defs/Evidence"
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "https://chef.local/schema/recon-graph/1.4.0#/$defs/Relationship"
      }
    },
    "unmappedEventTypes": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": { "maxLength": 64 },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "evidence" } } },
      "then": {
        "properties": {
          "assets": { "type": "array", "maxItems": 0 },
          "relationships": { "type": "array", "maxItems": 0 },
          "unmappedEventTypes": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "assets" } } },
      "then": {
        "properties": {
          "evidence": { "type": "array", "maxItems": 0 },
          "relationships": { "type": "array", "maxItems": 0 },
          "unmappedEventTypes": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "relationships" } } },
      "then": {
        "properties": {
          "assets": { "type": "array", "maxItems": 0 },
          "evidence": { "type": "array", "maxItems": 0 },
          "unmappedEventTypes": { "type": "object", "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "completed" } } },
      "then": {
        "properties": {
          "assets": { "type": "array", "maxItems": 0 },
          "evidence": { "type": "array", "maxItems": 0 },
          "relationships": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ]
}

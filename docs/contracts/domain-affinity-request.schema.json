{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chef.invalid/contracts/domain-affinity-request.schema.json",
  "title": "Solicitud de análisis local de afinidad nominal CHEF",
  "description": "Solicitud IPC de solo lectura. Las raíces son criterios explícitos de agrupación local; no habilitan resolución DNS ni otro tráfico.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "analysisRoots"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "analysisRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 253 }
    }
  }
}

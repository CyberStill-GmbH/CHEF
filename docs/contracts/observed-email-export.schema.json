{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chef.invalid/contracts/observed-email-export.schema.json",
  "title": "Exportación local de correos observados CHEF",
  "description": "Direcciones directas EMAIL_ADDRESS con evidencia y linaje. Contiene datos personales y no afirma scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "fileName",
    "contentType",
    "scopeStatus",
    "emailCount",
    "emails"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^run:[a-z0-9:-]+$"
    },
    "fileName": {
      "type": "string",
      "maxLength": 170,
      "pattern": "^chef-correos-observados-run-[a-z0-9-]+\\.json$"
    },
    "contentType": { "const": "application/json; charset=utf-8" },
    "scopeStatus": { "const": "not_asserted" },
    "emailCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "emails": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "evidence"],
        "properties": {
          "address": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "parentEvidenceId", "observedAt"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 160 },
                "parentEvidenceId": {
                  "type": ["string", "null"],
                  "maxLength": 160
                },
                "observedAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    }
  }
}

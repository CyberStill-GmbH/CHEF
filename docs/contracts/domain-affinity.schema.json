{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chef.invalid/contracts/domain-affinity.schema.json",
  "title": "Informe local de afinidad nominal de dominios CHEF",
  "description": "Respuesta IPC versionada de un análisis offline del grafo de eventos importados. El puntaje solo ordena señales heurísticas: no es riesgo, propiedad, autorización ni alcance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "analysisRoots", "candidates"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "analysisRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 253 }
    },
    "candidates": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventType",
        "locator",
        "observedAt",
        "scopeDistance",
        "affiliateTagged"
      ],
      "properties": {
        "eventId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "eventType": { "const": "DNS_NAME" },
        "locator": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "observedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "scopeDistance": { "type": "integer", "minimum": 1, "maximum": 32 },
        "affiliateTagged": { "type": "boolean" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidateDomain",
        "analysisRoots",
        "reason",
        "ruleId",
        "ruleVersion",
        "score",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "candidateDomain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "analysisRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 256 },
        "ruleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ruleVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "score": { "type": "number", "minimum": 0, "maximum": 256 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}

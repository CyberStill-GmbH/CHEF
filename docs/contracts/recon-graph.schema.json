{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chef.local/schema/recon-graph/1.4.0",
  "title": "Grafo local de reconocimiento CHEF 1.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assets",
    "evidence",
    "relationships",
    "unmappedEventTypes"
  ],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0"] },
    "assets": {
      "type": "array",
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/Asset" }
    },
    "evidence": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/Evidence" }
    },
    "relationships": {
      "type": "array",
      "maxItems": 40000,
      "items": { "$ref": "#/$defs/Relationship" }
    },
    "unmappedEventTypes": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": { "minLength": 1, "maxLength": 64 },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    }
  },
  "$defs": {
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "key",
        "qualification",
        "firstSeen",
        "lastSeen",
        "evidenceIds"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "domain",
            "ip_address",
            "service",
            "web_endpoint",
            "technology",
            "certificate",
            "candidate_finding",
            "organization"
          ]
        },
        "key": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "qualification": {
          "enum": [
            "observed_open",
            "observed",
            "unverified",
            "hint",
            "candidate",
            "unresolved",
            null
          ]
        },
        "firstSeen": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceEventId",
        "parentEvidenceId",
        "eventType",
        "observedAt",
        "locator",
        "module",
        "redacted"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceEventId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "parentEvidenceId": { "type": ["string", "null"] },
        "eventType": { "type": "string", "minLength": 1, "maxLength": 64 },
        "observedAt": { "type": "string", "format": "date-time" },
        "locator": { "type": "string", "maxLength": 256 },
        "module": { "type": ["string", "null"], "maxLength": 128 },
        "redacted": { "type": "boolean" }
      }
    },
    "Relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fromAssetId",
        "toAssetId",
        "kind",
        "assertion",
        "evidenceIds"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fromAssetId": { "type": "string", "minLength": 1 },
        "toAssetId": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "resolves_to",
            "parent_domain_of",
            "exposes_service",
            "serves_endpoint",
            "uses_technology",
            "presents_certificate",
            "reports_candidate"
          ]
        },
        "assertion": {
          "enum": ["observed", "candidate", "unverified", "hint"]
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": { "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0"] }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "assets": {
            "type": "array",
            "items": {
              "not": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "domain" },
                      "qualification": { "enum": ["hint", "unresolved"] }
                    },
                    "required": ["kind", "qualification"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "ip_address" },
                      "qualification": { "const": "hint" }
                    },
                    "required": ["kind", "qualification"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "organization" }
                    },
                    "required": ["kind"]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

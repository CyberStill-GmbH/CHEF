{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chef.local/contracts/dns-observation-batch.schema.json",
  "title": "DNS Observation Batch",
  "description": "Registro local versionado de consultas DNS autorizadas, saneado y vinculado a evidencia CHEF existente.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "termination", "observations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "batchId": { "type": "string", "pattern": "^dns-batch:[a-z0-9:_-]{1,118}$" },
    "termination": {
      "enum": ["completed", "invalid_query", "limit_exceeded", "not_authorized", "invalid_authorization", "authorization_expired", "cancelled"]
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/queryObservation" }
    }
  },
  "$defs": {
    "queryObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerName", "scopeHost", "recordType", "observedAt", "resolutionHops", "authorizationId", "authorizationScopeDigest", "sourceEvidenceId", "outcome"],
      "properties": {
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 253 },
        "scopeHost": { "type": "string", "minLength": 1, "maxLength": 253 },
        "recordType": { "const": "SRV" },
        "observedAt": { "type": "string", "format": "date-time" },
        "resolutionHops": { "type": "integer", "minimum": 0, "maximum": 32 },
        "authorizationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorizationScopeDigest": { "$ref": "#/$defs/sha256" },
        "sourceEvidenceId": { "oneOf": [{ "$ref": "#/$defs/evidenceId" }, { "type": "null" }] },
        "outcome": { "$ref": "#/$defs/outcome" }
      }
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "answers"],
          "properties": {
            "status": { "const": "answers" },
            "answers": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/answer" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "no_answers" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "failure"],
          "properties": {
            "status": { "const": "failed" },
            "failure": { "enum": ["name_not_found", "timeout", "server_failure", "refused", "network", "invalid_response", "other"] }
          }
        }
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "ttlSeconds", "disposition", "rdataSha256", "targetCandidates"],
      "properties": {
        "recordType": { "const": "SRV" },
        "ttlSeconds": { "type": "integer", "minimum": 0 },
        "disposition": { "enum": ["follow_up_allowed", "evidence_only"] },
        "rdataSha256": { "$ref": "#/$defs/sha256" },
        "targetCandidates": { "type": "array", "maxItems": 4096, "items": { "type": "string", "minLength": 1, "maxLength": 253 } }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "evidenceId": { "type": "string", "pattern": "^chef-evidence:[a-fA-F0-9]{64}$" }
  }
}
